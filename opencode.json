{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "spec/constitution.md",
    "spec/progress.md",
    "spec/workflow.md",
    "spec/platform-readiness.md",
    "spec/design-first.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git worktree*": "ask",
      "ls*": "allow",
      "scripts/verify.sh*": "allow",
      "scripts/fix-mode.sh on": "allow",
      "scripts/fix-mode.sh off": "ask",
      "pnpm test*": "allow",
      "pnpm lint*": "allow",
      "pnpm typecheck*": "allow",
      "pnpm build*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    }
  }
}
